# Rust
/target/
/target-*/
**/*.rs.bk

# Node / frontend
node_modules
dist/
dist-capture/
*.tsbuildinfo

# README screenshot sources. Generated locally by scripts/capture-demo-*.sh;
# only the composed docs/images/hero*.png product shots are committed.
docs/images/home.png
docs/images/home.zh-CN.png
docs/images/home.version
docs/images/mobile-home.png
docs/images/mobile-home.zh-CN.png
docs/images/mobile-apps.png
docs/images/mobile-apps.zh-CN.png
docs/images/mobile.version

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log

# Android / libbox binaries. Built locally; not source.
*.aar
*.apk
*.aab
*.so

# Tauri plugin build copies the Android runtime into this directory.
**/.tauri/

# Tauri generated (capabilities / schema)
apps/desktop/src-tauri/gen/

# sing-box binaries (fetched locally; keep scripts / pin / license notice)
third_party/sing-box/**
!third_party/sing-box/VERSION
!third_party/sing-box/CHECKSUMS.sha256
!third_party/sing-box/LICENSE
!third_party/sing-box/.gitkeep

# Copied into the Tauri bundle at build time (CI-6: GeoIP source is third_party/)
apps/desktop/src-tauri/resources/sing-box
apps/desktop/src-tauri/resources/sing-box.exe
apps/desktop/src-tauri/resources/geoip/
apps/desktop/src-tauri/resources/ice-helper
apps/desktop/src-tauri/resources/ice-tun-launcher.exe
apps/desktop/src-tauri/resources/libcronet.dll
!apps/desktop/src-tauri/resources/.gitkeep
