{
  "build": {
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-singbox-resource.ps1 -Platform win && npm run build"
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "resources/sing-box.exe": "sing-box.exe",
      "resources/sing-box": null,
      "resources/geoip": "geoip"
    },
    "nsis": {
      "languages": ["SimpChinese", "English"],
      "customLanguageFiles": {
        "English": "nsis/English.nsh",
        "SimpChinese": "nsis/SimpChinese.nsh"
      }
    }
  }
}
