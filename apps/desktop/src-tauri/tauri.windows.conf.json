{
  "build": {
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-singbox-resource.ps1 -Platform win && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ice-box",
        "width": 860,
        "height": 620,
        "minWidth": 720,
        "minHeight": 500,
        "decorations": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "resources/sing-box.exe": "sing-box.exe",
      "resources/sing-box": null,
      "resources/ice-tun-launcher.exe": "ice-tun-launcher.exe",
      "resources/geoip": "geoip",
      "resources/ice-helper": null
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "./nsis/installer-hooks.nsh",
        "customLanguageFiles": {
          "English": "nsis/English.nsh",
          "SimpChinese": "nsis/SimpChinese.nsh"
        }
      }
    }
  }
}
