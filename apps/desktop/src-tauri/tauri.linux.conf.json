{
  "build": {
    "beforeBuildCommand": "bash ../../scripts/prepare-singbox-resource.sh host && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ice-box",
        "width": 740,
        "height": 620,
        "minWidth": 600,
        "minHeight": 500,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "resources/sing-box": "sing-box",
      "resources/geoip": "geoip",
      "resources/ice-helper": "ice-helper"
    },
    "category": "Utility",
    "shortDescription": "Lightweight sing-box proxy client",
    "linux": {
      "deb": {
        "section": "net",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "polkitd | policykit-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
